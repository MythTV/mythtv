#!/bin/zsh

# This script sets the Python, Mythtv, MySQL, and Qt paths

# First set the default language so the python
# metadata grabbes work correctly
export LANG=$(defaults read -g AppleLanguages | sed '/"/!d;s/["[:space:]]//g;s/-/_/').UTF-8

# get the directory of the calling funcitons
BASE_DIR=$(dirname $0)
BASE_DIR=$(realpath $BASE_DIR)
if [ ${BASE_DIR:0:1} = "." ] ;then
  BASE_DIR=$(pwd)/${BASE_DIR:2}
fi

# get the location of the APP_BUNDLE
APP_DIR=$(realpath "$BASE_DIR/../..")
RSRC_DIR=$APP_DIR/Contents/Resources
PLUGIN_DIR=$APP_DIR/Contents/PlugIns

# Add the App Bundle's executables to the search path
export PATH=$BASE_DIR:$RSRC_DIR/bin:$PATH

# The hash command must be called to get it to forget past
# commands. Without forgetting past commands the $PATH changes
# we made may not be respected
hash -r 2>/dev/null || true

# Set the python3 path
PYTHON_BASE_PATH=$RSRC_DIR/lib/@PYTHON_BASENAME@
export PYTHONPATH=$PYTHON_BASE_PATH:$PYTHON_BASE_PATH/site-packages:$PYTHON_BASE_PATH/lib-dynload

# set the mythtv share dir
export MYTHTVDIR="$RSRC_DIR"

# Configure trusted root CAs for TLS database connections, defaulting to macOS's system bundle
CONF_DIR="${MYTHTVCONFDIR:-$HOME/.mythtv}"
CUSTOM_CA_FOUND=0

if [ -z "$SSL_CERT_FILE" ]; then
  for CERT_CANDIDATE in \
    "$CONF_DIR/certificates/mysql-ca.pem" \
    "$CONF_DIR/certificates/ca.pem" \
    "$HOME/Library/Application Support/MythTV/certificates/mysql-ca.pem" \
    "$HOME/Library/Application Support/MythTV/certificates/ca.pem"
  do
    if [ -f "$CERT_CANDIDATE" ]; then
      export SSL_CERT_FILE="$CERT_CANDIDATE"
      CUSTOM_CA_FOUND=1
      break
    fi
  done
else
  CUSTOM_CA_FOUND=1
fi

export SSL_CERT_FILE="${SSL_CERT_FILE:-/etc/ssl/cert.pem}"

# If no custom CA was supplied and config.xml points to an IP address or local hostname
# (which cannot be validated by public root CAs in /etc/ssl/cert.pem), disable peer verification.
if [ -z "$MARIADB_TLS_DISABLE_PEER_VERIFICATION" ] && [ "$CUSTOM_CA_FOUND" -eq 0 ] && [ -f "$CONF_DIR/config.xml" ]; then
  DB_HOST=$(xmllint --xpath 'string(//Database/Host)' "$CONF_DIR/config.xml" 2>/dev/null | tr -d '[:space:]')
  if [[ -z "$DB_HOST" ]] || \
     [[ "$DB_HOST" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] || \
     [[ "$DB_HOST" == *:* ]] || \
     [[ "$DB_HOST" != *.* ]] || \
     [[ "$DB_HOST" == *.local ]]; then
    export MARIADB_TLS_DISABLE_PEER_VERIFICATION=1
  fi
fi

# Define the runtime path to the bundled database plugins
export MARIADB_PLUGIN_DIR="$PLUGIN_DIR/@QT_MYSQL_PROVIDER@/plugin"
export MYSQL_PLUGIN_DIR="$PLUGIN_DIR/@QT_MYSQL_PROVIDER@/plugin"

# Define the Qt Plugin Paths
unset QT_PLUGIN_PATH
export QT_PLUGIN_PATH="$PLUGIN_DIR"
export QT_AUTOLOAD_PLUGINS=0

cd $BASE_DIR
./@APP_EXE_NAME@ $@
